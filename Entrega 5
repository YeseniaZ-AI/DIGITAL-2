            # Envía por Telegram la lista de comandos que puede usar el usuario
                "Comandos disponibles:\n"
                "/status -> Ver estado actual\n"
                "/settemp [valor] -> Cambiar umbral de temperatura\n"
                "/sethum [valor] -> Cambiar umbral de humedad\n"
                "/silencio_temp -> Apagar alarma temperatura\n"
                "/silencio_hum -> Apagar alarma humedad\n"
                "/silencio_panic -> Apagar alarma boton panico\n"
                "/reset -> Reactivar todas las alarmas\n"
            )

        # --- Comando /status ---
        elif texto == "/status": # Si el usuario pide /status, muestra el estado actual de temperatura y humedad
            print(f"Temp: {temp}°C Hum: {hum}%  Umbral Temp: {umbral_temp}°C  Umbral Hum: {umbral_hum}%")
