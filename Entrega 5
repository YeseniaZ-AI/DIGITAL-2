# --- Función para emitir un pitido (beep) con el buzzer ---
def beep(frecuencia, duracion):
    pwm = PWM(buzzer)        # Activa PWM sobre el buzzer
    pwm.freq(frecuencia)     # Define frecuencia del tono
    pwm.duty(512)            # Define intensidad (mitad del ciclo)
    time.sleep_ms(duracion)  # Tiempo de duración del tono
    pwm.deinit()             # Detiene PWM
    sleep(0.05)              # Pausa corta entre pitidos

# --- Botón de pánico con antirrebote ---
ultimo_tiempo = 0  # guarda cuando fue la última pulsación válida
delay_rebote = 200  # Tiempo mínimo entre pulsaciones (ms)
evento_pendiente = None

def Evento1(p):
    """Interrupción del botón con antirrebote"""
    global evento_pendiente, ultimo_tiempo  # usa/actualiza variables globales del botón
    ahora = time.ticks_ms()  # tiempo actual en ms (reloj del sistema)
    if ahora - ultimo_tiempo < delay_rebote: # ¿ocurrió muy pronto desde la última pulsación?
        return # descarta el evento (rebote)
    ultimo_tiempo = ahora  # actualiza el momento de la última pulsación válida
    evento_pendiente = p  # Marca que hubo evento de botón

boton.irq(trigger=Pin.IRQ_FALLING, handler=Evento1)  # Detecta pulsación (borde descendente)

