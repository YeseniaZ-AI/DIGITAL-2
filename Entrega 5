        request = str(request) # Convierte la solicitud a texto para analizarla

        # Acciones desde el panel web
        if "/silencio_temp" in request: # Si el usuario presiona el botón de silenciar temperatura en la página
            alarma_temp_activa = False #desactiva la alarma
            alerta = "Alarma de temperatura silenciada desde Web"
            bot.send(miID, alerta) #aviso por telegram

        elif "/silencio_hum" in request: # Si se presiona el botón para silenciar humedad
            alarma_hum_activa = False #desactiva la alarma
            alerta = "Alarma de humedad silenciada desde Web"
            bot.send(miID, alerta)

        elif "/silencio_panic" in request:#si se presiona el boton panico
            alarma_panic_activa = False #desactiva el estado de alarma
            alarma_panic_sonando = False #detiene cualquier sonido
            alerta = "Alarma de botón de pánico silenciada desde Web"
            bot.send(miID, "Botón de panico silenciado desde la Web")

        elif "/reset" in request: # Si se presiona el botón de reiniciar alarmas
            alarma_temp_activa = True #reactiva las alarmas
            alarma_hum_activa = True
            alarma_panic_activa = True
            alerta = "Todas las alarmas reactivadas desde Web"
            bot.send(miID, alerta)

        # Envía la página HTML actualizada
        response = web_page(temp, hum, alerta, umbral_temp, umbral_hum) # Genera la página con los valores actuales
        conn.send(b'HTTP/1.1 200 OK\n') # Responde al navegador que todo está bien
        conn.send(b'Content-Type: text/html\n')  # Indica que se enviará contenido HTML
        conn.send(b'Connection: close\n\n')  # Cierra la conexión después de enviar la página
        conn.sendall(response.encode()) # Envía el contenido HTML generado
        conn.close() # Termina la conexión con el navegador
    except OSError: # Ignora errores si no hay conexión o se interrumpe
        pass
