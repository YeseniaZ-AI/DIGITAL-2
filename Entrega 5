                nuevo_valor = int(texto.split()[1])
                umbral_hum = nuevo_valor
                alerta = f"Nuevo umbral de humedad: {umbral_hum}%"
                bot.send(chat_id, alerta)
            except: # Muestra mensaje de ayuda si el comando está mal escrito
                bot.send(chat_id, "Usa el formato: /sethum 70")
                
        # --- Silenciar alarma de temperatura ---
        elif texto == "/silencio_temp":  # Desactiva la alarma de temperatura  
            alarma_temp_activa = False #apaga el buzzer si estaba sonando
            buzzer.off()
            alerta = "Alarma de temperatura silenciada"
            bot.send(chat_id, alerta) #aviso por telegram

        # --- Silenciar alarma de humedad ---
        elif texto == "/silencio_hum":
