# --- Función para generar la página web con los valores actuales ---
def web_page(temp, hum, alerta, umbral_temp, umbral_hum): 
    html = html_base
    # Reemplaza los marcadores del HTML con los datos actuales
    html = html.replace("{{temp}}", str(temp))
    html = html.replace("{{hum}}", str(hum))
    html = html.replace("{{alerta}}", alerta)
    html = html.replace("{{umbral_temp}}", str(umbral_temp))
    html = html.replace("{{umbral_hum}}", str(umbral_hum))
    return html # Retorna el HTML final listo para mostrar en el navegador

# --- Variables iniciales ---
temp, hum = 0, 0 # Inicia los valores de temperatura y humedad en cero
ultimo_lectura = time.ticks_ms()  # Guarda el momento de la última lectura del sensor
# Define los límites de temperatura y humedad que activan las alarmas
umbral_temp = 30  # Temperatura límite
umbral_hum  = 70  # Humedad límite

# --- Bucle principal del sistema ---
while True:  # Ciclo principal que mantiene el sistema corriendo todo el tiempo

    # --- Leer nuevos mensajes de Telegram ---
    nuevo_mensaje = bot.read_once()  # Revisa si llegó un nuevo mensaje al bot de Telegram

