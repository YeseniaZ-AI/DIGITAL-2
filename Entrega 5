        # --- Silenciar botón de pánico ---
        elif texto == "/silencio_panic":
            bot.send(miID, "Alarma de panico desactivada")
            alarma_panic_activa = False
            alarma_panic_sonando = False
            buzzer.off()
            
        # --- Reactivar todas las alarmas ---
        elif texto == "/reset":
            alarma_temp_activa = True
            alarma_hum_activa = True
            alarma_panic_activa = True
            alerta = "Todas las alarmas reactivadas"
            bot.send(chat_id, alerta)

    # --- Lectura periódica del sensor DHT11 ---
    if time.ticks_diff(time.ticks_ms(), ultimo_lectura) > 1000:
        # Leo el sensor cada segundo para actualizar temperatura y humedad
        try:
            sensor.measure()  # Le pido al DHT11 que mida temperatura y humedad
            temp = sensor.temperature() #guarda la temp actual
            hum = sensor.humidity() #guarda la hum actual
        except OSError:
            temp, hum = 0, 0 # Si falla la lectura, pongo 0 y aviso del error
            print("Error al leer el DHT11")
        ultimo_lectura = time.ticks_ms() #actualiza el tiempo de la ultima lectura

